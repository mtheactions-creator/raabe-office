{
  "name": "raabe-office",
  "private": true,
  "version": "0.1.0",
  "description": "RaabeWrite, RaabeCalc, RaabePresent: a lean, offline office suite for the Raabeschule.",
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:write": "npm run dev -w @raabe/write",
    "build:write": "npm run tauri -w @raabe/write -- build",
    "dev:calc": "npm run dev -w @raabe/calc",
    "build:calc": "npm run tauri -w @raabe/calc -- build",
    "dev:present": "npm run dev -w @raabe/present",
    "build:present": "npm run tauri -w @raabe/present -- build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
